DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnierp_dev?schema=public"
# Separate low-privilege role the app actually connects as at runtime, so RLS
# cannot be bypassed by a superuser/table-owner connection (see prisma/sql/002_rls.sql).
APP_DATABASE_URL="postgresql://omnierp_app:omnierp_app@localhost:5432/omnierp_dev?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3000
